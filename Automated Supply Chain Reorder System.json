      "id": "1ca88d5e-527f-4945-a58d-aba226b72a5c",
      "name": "Daily Inventory Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -128,
        32
      ]
    },
    {
      "parameters": {
        "jsCode": "// গুগল শিট থেকে আসা সব সারি (Rows) সংগ্রহ করা\nconst items = $input.all();\n\nreturn items.map(row => {\n  const data = row.json;\n  const stock = Number(data.current_stock);\n  const rop = Number(data.reorder_point);\n\n  return {\n    json: {\n      sku: data.sku,\n      item: data.item,\n      current_stock: stock,\n      reorder_point: rop,\n      vendor_email: data.vendor_email,\n      status: stock <= rop ? \"REORDER_NEEDED\" : \"SUFFICIENT\"\n    }\n  };\n});\n"
      },
      "id": "b64e53f6-5472-4b5a-8f16-d3a0184486e7",
      "name": "Fetch & Calculate ROP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        32
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.current_stock }}",
              "operation": "smallerEqual",
              "value2": "={{ $json.reorder_point }}"
            }
          ]
        }
      },
      "id": "7d81df9d-3866-4142-81d2-f87918547e17",
      "name": "Check Low Stock",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        560,
        32
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3-flash-preview"
        },
        "messages": {
          "values": [
            {
              "content": "=Write a formal Purchase Order (PO) email to the vendor for this low-stock product:\nProduct: {{ $json.item }} (SKU: {{ $json.sku }})\nCurrent Stock: {{ $json.current_stock }} | Reorder Point: {{ $json.reorder_point }}\nRequest immediate restocking of 500 units and ask for delivery confirmation.\n"
            }
          ]
        },
        "builtInTools": {},
        "options": {}

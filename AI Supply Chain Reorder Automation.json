    {
      "parameters": {
        "jsCode": "\nconst inventory = [\n  { part_number: \"FILTER-001\", description: \"Aircraft Filter\", stock: 5, reorder_level: 10, unit_price: 120 },\n  { part_number: \"SEAL-002\", description: \"Rubber Seal\", stock: 25, reorder_level: 10, unit_price: 15 },\n  { part_number: \"LAMP-003\", description: \"Cabin Lamp\", stock: 2, reorder_level: 5, unit_price: 45 },\n];\n\nreturn inventory.map(item => ({\n  json: {\n    ...item,\n    status: item.stock <= item.reorder_level ? \"REORDER REQUIRED\" : \"STOCK OK\",\n    suggested_order_quantity: Math.max(0, item.reorder_level * 2 - item.stock)\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
